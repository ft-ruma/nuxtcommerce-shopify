# Shopify store domain (the .myshopify.com one)
SHOPIFY_STORE_DOMAIN="your-store.myshopify.com"

# Storefront API token from the Headless channel (or a custom app).
# Use the PRIVATE token if you can; the public one also works.
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=""
SHOPIFY_STOREFRONT_TOKEN=""

# Storefront API version
SHOPIFY_API_VERSION="2026-04"

# Country used for prices/currency and to prefill the checkout address (ISO code, e.g. LK, US, GB)
SHOPIFY_COUNTRY_CODE="LK"

# Collection handles to hide from the category menus (comma separated)
SHOPIFY_HIDDEN_COLLECTIONS="frontpage"
